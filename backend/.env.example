# Copy to backend/.env for local runs. Never commit real secrets.
# SQLite fallback (works without Docker). Postgres URL for `docker compose up -d`.
DATABASE_URL=sqlite:///./filemind_dev.db
# DATABASE_URL=postgresql+psycopg2://filemind:filemind_dev_only@localhost:5432/filemind

SECRET_KEY=change-me-in-local-env-only
JWT_SECRET_KEY=change-me-in-local-env-only
JWT_EXPIRE_MINUTES=1440
STORAGE_DIR=./storage
MAX_UPLOAD_MB=50
AI_PROCESSING_ENABLED=false
# Optional external AI (OpenAI-compatible). Leave empty to stay fully local.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=tfidf-local
STORAGE_DIR=./storage
MAX_UPLOAD_MB=50
AI_PROCESSING_ENABLED=false
